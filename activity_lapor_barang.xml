<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/first_page"
    android:padding="20dp"
    tools:context=".LaporBarangActivity">

    <!-- Header Section -->
    <ImageView
        android:id="@+id/btnBackLapor"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="Back"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvHeaderTitle" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/archivo_black"
        android:text="Lapor Barang"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintStart_toEndOf="@id/btnBackLapor"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Line Divider -->
    <View
        android:id="@+id/lineHeaderDivider"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:background="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lineHeaderDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Photo Preview Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_rounded_card"
                android:padding="4dp">

                <ImageView
                    android:id="@+id/imgPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/sample_dompet"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Take Photo Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAmbilFoto"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_green"
                android:fontFamily="@font/tienne"
                android:text="Ambil foto"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- RadioGroup Input Widget with RadioButtons ("Hilang" / "Temuan") -->
            <RadioGroup
                android:id="@+id/rgTipeBarang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbHilang"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radio_purple_selector"
                    android:button="@null"
                    android:checked="true"
                    android:fontFamily="@font/syne"
                    android:gravity="center"
                    android:text="Hilang"
                    android:textColor="@color/radio_text_color_selector"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbTemuan"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_radio_purple_selector"
                    android:button="@null"
                    android:fontFamily="@font/syne"
                    android:gravity="center"
                    android:text="Temuan"
                    android:textColor="@color/radio_text_color_selector"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Form EditText Input Widgets -->
            <EditText
                android:id="@+id/etNamaBarang"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/syne"
                android:hint="Nama barang"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etLokasi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/syne"
                android:hint="Lokasi"
                android:inputType="textCapSentences"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_field"
                android:fontFamily="@font/syne"
                android:hint="Deskripsi"
                android:inputType="textCapSentences"
                android:paddingHorizontal="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />

            <!-- Submit Button Widget -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKirimLaporan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_button_cyan"
                android:fontFamily="@font/syne"
                android:text="Kirim Laporan"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>