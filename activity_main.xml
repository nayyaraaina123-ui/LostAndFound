<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_kuning">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Row: Hamburger Button + Search Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="Menu"
                    android:focusable="true"
                    android:padding="4dp"
                    android:src="@drawable/ic_menu" />

                <EditText
                    android:id="@+id/etCari"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search"
                    android:drawableEnd="@android:drawable/ic_menu_search"
                    android:fontFamily="@font/syne"
                    android:hint="Cari Barang"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgTab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbSemua"
                    style="@style/TabStyle"
                    android:checked="true"
                    android:text="Semua" />

                <RadioButton
                    android:id="@+id/rbHilang"
                    style="@style/TabStyle"
                    android:text="Hilang" />

                <RadioButton
                    android:id="@+id/rbTemuan"
                    style="@style/TabStyle"
                    android:text="Temuan" />
            </RadioGroup>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBarang"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLapor"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:background="@drawable/bg_btn_lapor"
            android:fontFamily="@font/syne"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="+ Lapor"
            android:textAllCaps="false"
            android:textColor="@color/hitam"
            android:textSize="18sp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Side Navigation Drawer -->
    <LinearLayout
        android:id="@+id/navDrawerContent"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/biru_drawer"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/btnBackDrawer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="Tutup Menu"
            android:focusable="true"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/navBeranda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_drawer_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/syne"
            android:padding="12dp"
            android:text="✴ Beranda"
            android:textColor="@color/putih"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navLaporanSaya"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/syne"
            android:padding="12dp"
            android:text="✴ Laporan Saya"
            android:textColor="@color/hitam"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>